+    fn eq_mr_desc() -> &'static str;
+
+    fn eq_mr_supported_names() -> Vec<&'static str>;
+
+    fn filter_ava_eq(
+        _pb: &mut PblockRef,
+        _bval_filter: &BerValRef,
+        _vals: &ValueArrayRef,
+    ) -> Result<bool, PluginError> {
+        Ok(false)
+    }
