+    try:
+        with open(schema_filename, 'w') as schema_file:
+            schema_file.write("dn: cn=schema\n")
+            schema_file.write("attributetypes: ( 1.3.6.1.1.1.1.2 NAME " +
+                              "'gecos' DESC 'The GECOS field; the common name' " +
