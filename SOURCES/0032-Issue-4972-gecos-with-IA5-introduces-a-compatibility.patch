+    testuser = UserAccount(m1, testuser_dn)
+    try:
+        testuser.create(properties={
+            'uid': 'testuser',
+            'cn': 'testuser',
+            'sn': 'testuser',
+            'uidNumber' : '1000',
+            'gidNumber' : '2000',
+            'homeDirectory' : '/home/testuser',
